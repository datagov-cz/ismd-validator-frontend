# BE_URL: server-side only — used by Next.js rewrites to proxy /api/* and swagger paths to the backend.
#
# Use host.docker.internal instead of localhost — works across all environments:
#   - WSL (npm run dev inside WSL, backend running in Windows/IDEA)
#   - PowerShell / Git Bash (backend in IDEA or Docker)
#   - Docker containers (via Docker Desktop host resolution)
#
# localhost does NOT work when running npm run dev from WSL with the backend on Windows.
BE_URL=http://host.docker.internal:8080/validujeme

NEXT_PUBLIC_CONVERT_FORMAT="json or ttl"
NEXT_PUBLIC_CONVERT_REMOVE_INVALID_SOURCES="true or false"
NEXT_PUBLIC_INCLUDE_DETAILED_REPORT="true or false"
